# Safe local test
RUN_MODE=sample
NOTIFY_MODE=console

# SQL Server mode
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=master
DB_USER=sa
DB_PASSWORD=replace_with_a_local_password
DB_TRUST_SERVER_CERTIFICATE=yes

# Only required when NOTIFY_MODE=telegram or both
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_id
TELEGRAM_PARSE_MODE=HTML
